{
	"name": "pi-extensions",
	"version": "0.0.0",
	"private": true,
	"description": "A collection of Pi coding-agent extensions, one package per directory",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"pi-package",
		"pi-extensions",
		"pi-coding-agent"
	],
	"pi": {
		"extensions": [
			"./packages/*/src/index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"check": "pnpm lint && pnpm typecheck && pnpm test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@earendil-works/pi-agent-core": "^1.1.0",
		"@earendil-works/pi-ai": "^1.1.0",
		"@earendil-works/pi-coding-agent": "^1.1.0",
		"@earendil-works/pi-tui": "^1.1.0",
		"@types/node": "^22.0.0",
		"typebox": "^1.3.27",
		"typescript": "^7.0.2",
		"vitest": "^5.0.4"
	}
}
